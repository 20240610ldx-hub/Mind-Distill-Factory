# Copy these values into evaluation/runtime/.env and edit locally.
# Keep real API keys out of reports and shared artifacts.

# off: never call an external LLM.
# auto: call an external LLM only when an API key is available.
# deepseek: require the configured DeepSeek-compatible API for generation/judging.
MIND_DISTILL_EVAL_LLM=off

MIND_DISTILL_EVAL_API_KEY=
MIND_DISTILL_EVAL_BASE_URL=https://api.deepseek.com
MIND_DISTILL_EVAL_MODEL=deepseek-v4-pro
MIND_DISTILL_EVAL_REASONING_EFFORT=max
