{
  "version": "2.0",
  "output": {
    "languages": ["zh"],
    "skill_install_path": "~/.claude/skills/{person-slug}-wisdom/",
    "gallery_path": "./gallery/{person-slug}/",
    "output_path": "./output/{person-slug}/",
    "english_on_demand": true,
    "english_install_path": "~/.claude/skills/{person-slug}-wisdom-en/"
  },
  "package_budget": {
    "format_version": 6,
    "skill_max_lines": 500,
    "reference_dir": "references",
    "required_refs": ["cases.md", "evidence.md", "voice.md"],
    "cases_max_tokens": 4000,
    "evidence_max_tokens": 3000,
    "voice_max_tokens": 2000,
    "dossier_in_install_dir": false
  },
  "distillation": {
    "_comment": "min/max_principles here are v6 targets consumed by agent prompts (framework-synthesizer-zh/en, skill-assembler) — not read by scripts/validate_output.py, which enforces its own module-level constants instead (FRAMEWORK_SCHEMA_V6_PRINCIPLES 8-11 for v6, FRAMEWORK_SCHEMA 5-8 for legacy). The two happen to agree for v6; this field does not drive that agreement.",
    "min_principles": 8,
    "max_principles": 11,
    "principle_target_chars": 900,
    "min_reasoning_patterns": 3,
    "max_reasoning_patterns": 5,
    "min_blind_spots": 2,
    "min_quotes": 5,
    "max_quotes": 10,
    "min_cases_per_cluster": 2,
    "min_counter_cases": 1,
    "min_voice_samples": 20
  },
  "source_strategy": {
    "priority": "user-provided-first",
    "user_source_path": "./sources/{person-slug}/raw/",
    "processed_path": "./sources/{person-slug}/processed/",
    "supported_formats": ["pdf", "txt", "md"],
    "fallback": "web-search",
    "registry": {
      "schema_version": "source-registry-v2",
      "require_sha256": true,
      "allow_nested_raw_paths": true,
      "rights_status_default": "unverified"
    },
    "pdf": {
      "document_classes": ["pure_image_pdf", "mixed_text_image_pdf", "pure_text_pdf"],
      "native_backends": ["fitz", "pypdf"],
      "ocr_trigger": "substantive_image_or_low_quality_text",
      "ocr_default_backend": "rapidocr",
      "ocr_escalation_backend": "paddleocr",
      "ocr_page_quality_floor": 0.45
    },
    "sampling": {
      "seed_policy": "stable_sha256",
      "large_corpus_threshold_tokens": 150000,
      "budget_gate": true,
      "max_selected_input_tokens": 500000,
      "max_cost_usd": null,
      "modes": ["exhaustive", "stratified"]
    }
  },
  "quality": {
    "require_source_attribution": true,
    "require_blind_spots": true,
    "require_bilingual_review": false,
    "require_provenance_gates": true,
    "review_verdicts": ["PASS", "REVISE", "FAIL"]
  }
}
